# Any one key enables AI narration; with none, the app uses rule-based text.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDERS=gemini,groq,anthropic
GEMINI_MODEL=gemini-2.5-flash

# Optional: Redis Streams event bus (e.g. Upstash, use the rediss:// URL)
REDIS_URL=

# Replay tuning
BALL_INTERVAL_S=2.0
CONTEST_SIZE=20000

# Replay a real match: download a T20 JSON from https://cricsheet.org/matches/
# MATCH_FILE=app/data/your_match.json
